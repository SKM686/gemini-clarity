# GEMINI_API_KEY: Required for Gemini AI API calls.
# In local development: server-side only from .env (never exposed to browser or prefixed with VITE_).
# In production Cloud Run: Loaded from Google Cloud Secret Manager using runtime service account (ADC).
GEMINI_API_KEY=""

# Secret Manager production configuration (Server-side only)
GEMINI_PROJECT_ID="gen-lang-client-0498593678"
GEMINI_SECRET_NAME="My_Gemini_Key"
GEMINI_SECRET_VERSION="1" # Pinned Secret Manager version (never unpinned latest)
# Required IAM Role for Cloud Run Service Account:
# roles/secretmanager.secretAccessor on secret projects/{PROJECT_ID}/secrets/My_Gemini_Key

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

